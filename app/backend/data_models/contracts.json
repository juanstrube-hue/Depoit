        },
        "user_id": {
            "type": "string",
            "description": "User ID"
        },
        "landlord_name": {
            "type": "string",
            "description": "Landlord full name"
        },
        "landlord_email": {
            "type": "string",
            "description": "Landlord email"
        },
        "tenant_name": {
            "type": "string",
            "description": "Tenant full name"
        },
        "tenant_email": {
            "type": "string",
            "description": "Tenant email"
        },
        "broker_name": {
            "type": "string",
            "description": "Broker full name"
        },
        "broker_email": {
            "type": "string",
            "description": "Broker email"
        },
        "property_address": {
            "type": "string",
            "description": "Property address"
        },
        "property_city": {
            "type": "string",
            "description": "Property city/comuna"
        },
        "property_region": {
            "type": "string",
            "description": "Property region"
        },
        "property_type": {
            "type": "string",
            "description": "Property type"
        },
        "rent_amount": {
            "type": "integer",
            "description": "Monthly rent in CLP"
        },
        "deposit_amount": {
            "type": "integer",
